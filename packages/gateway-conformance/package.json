{
  "name": "@eks-agent/gateway-conformance",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Asserts that a ModelGateway route serves the wire contract it publishes — the only check that sends traffic through a live gateway rather than inspecting what the operator wrote.",
  "license": "Apache-2.0",
  "author": "stxkxs",
  "repository": {
    "type": "git",
    "url": "https://github.com/nanohype/eks-agent-platform.git",
    "directory": "packages/gateway-conformance"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "gateway-conformance": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src",
    "test": "vitest run src",
    "test:coverage": "vitest run src --coverage",
    "conformance": "tsx src/main.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "typescript": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
