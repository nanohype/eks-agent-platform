{
  "name": "eks-agent-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Kubernetes-native AWS-native platform-of-platforms. Bedrock + Envoy AI Gateway + DRA. Hosts agent workloads as declarative tenants via CRDs and operators.",
  "homepage": "https://github.com/nanohype/eks-agent-platform",
  "repository": {
    "type": "git",
    "url": "https://github.com/nanohype/eks-agent-platform.git"
  },
  "license": "Apache-2.0",
  "author": "stxkxs",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=24.14.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "test": "pnpm lint && turbo run typecheck test:coverage",
    "test:unit": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "docs": "pnpm build && typedoc",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check:schema-drift": "tsx scripts/check-schema-drift.mts",
    "tofu:fmt": "tofu fmt -recursive terraform/",
    "tofu:fmt:check": "tofu fmt -check -recursive terraform/",
    "tofu:validate": "for d in terraform/components/*/; do (cd \"$d\" && tofu init -backend=false -input=false >/dev/null && tofu validate) || exit 1; done",
    "helm:lint": "find charts -mindepth 1 -maxdepth 1 -type d -exec helm lint {} \\;",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "prepare": "husky",
    "check:doc-contracts": "./scripts/check-doc-contracts.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^25.8.0",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "tsx": "^4.22.0",
    "turbo": "^2.9.14",
    "typedoc": "0.28.20",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
